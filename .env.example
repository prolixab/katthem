# Set this in Coolify, or copy to .env for Docker Compose.
# Local npm start does not load .env.
APP_URL=https://katthem.example.se

# Valfritt: aktivera e-postpåminnelser via Resend
RESEND_API_KEY=
EMAIL_FROM=

# Engångsstart för befintlig installation utan superadmin: befintligt aktivt konto
BOOTSTRAP_SUPERADMIN_EMAIL=
